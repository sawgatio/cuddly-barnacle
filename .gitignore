# Unreal Engine .gitignore

# Visual Studio / Rider files
.vs/
.idea/
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Compiled binaries and intermediate files
Binaries/
Intermediate/
DerivedDataCache/
Saved/
Build/

# Package builds
Packages/
*.apk
*.ipa

# Crash reports and logs
Saved/Logs/
Saved/Crashes/

# Unreal Engine user settings
Saved/Config/WindowsEditor/
Saved/Config/WindowsNoEditor/

# Backup files
*.bak
*.tmp

# Web & Node dependencies
node_modules/
dist/
release-output/

# Android local build artifacts
.gradle/
android/.gradle/
android/app/build/
android/build/
android/captures/
android/.idea/

